# Production settings for BlinkScore. Copy to /srv/blinkscore/blinkscore.env,
# fill in, then: sudo chown root:blinkscore /srv/blinkscore/blinkscore.env
#                sudo chmod 640 /srv/blinkscore/blinkscore.env
# Never commit the filled-in copy.

# --- Database (kept outside the git checkout so deploys never touch it) ---
GRADEAI_DATABASE_URL=sqlite:////srv/blinkscore/data/data.db

# --- AI providers ---
GRADEAI_OPENAI_API_KEY=
GRADEAI_GROQ_API_KEY=

# --- Old BlinkScore demo (/demo/admin) shared password ---
GRADEAI_ADMIN_TOKEN=

# Local S-BERT scorer: weights live in the data dir (see deploy/README.md)
GRADEAI_SBERT_MODEL_DIR=/srv/blinkscore/data/models/all-MiniLM-L6-v2
GRADEAI_SBERT_ALLOW_DOWNLOAD=false

# --- Pilot ---
# First admin, created on first start if no admin exists. Use a long password.
GRADEAI_PILOT_BOOTSTRAP_ADMIN_EMAIL=
GRADEAI_PILOT_BOOTSTRAP_ADMIN_PASSWORD=
GRADEAI_PILOT_BOOTSTRAP_ADMIN_NAME=Admin
GRADEAI_PILOT_COOKIE_SECURE=true
GRADEAI_PILOT_GRADING_MODEL=gpt-4o-mini

# Google sign-in for teachers (see deploy/README.md, step 5)
GRADEAI_PILOT_PUBLIC_URL=https://blinkscore.in
GRADEAI_PILOT_GOOGLE_CLIENT_ID=
GRADEAI_PILOT_GOOGLE_CLIENT_SECRET=
