# GradeAI backend configuration.
# Copy this file to `.env` (same directory) and fill in real values.
# Every setting is read by app/config.py with the GRADEAI_ prefix; any of them
# can also be supplied as a real environment variable, which takes precedence.

# SQLAlchemy database URL. Defaults to a local SQLite file next to the process CWD.
GRADEAI_DATABASE_URL=sqlite:///./data.db

# JSON array of origins allowed by the CORS middleware (the Vite dev server ports).
GRADEAI_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174"]

# OpenAI API key used for AI grading. Required — grading returns an error without it.
GRADEAI_OPENAI_API_KEY=sk-your-openai-api-key-here

# OpenAI chat model used for grading.
GRADEAI_OPENAI_MODEL=gpt-4o-mini

# Groq API key. Models in app/models_registry.py with provider "groq" report
# available=false from GET /api/models until this is set.
GRADEAI_GROQ_API_KEY=gsk-your-groq-api-key-here

# Comma-separated model ids (see app/models_registry.py) used when a grading
# request omits model_ids. Keep this in sync with the models flagged
# default_selected in the registry (exposed on GET /api/models), which is what
# the student view pre-ticks on load.
GRADEAI_DEFAULT_MODEL_IDS=gpt-4o-mini,llama-3.1-8b-instant,minilm-l6-v2

# Minimum answer length, in characters after stripping whitespace, before an
# answer is sent to a model at all. Anything shorter is scored 0 locally with no
# API call — models confabulate a plausible grade out of an empty answer, so the
# only reliable fix is not to ask. Set to 0 to disable (a blank answer is still
# refused).
GRADEAI_MIN_ANSWER_CHARS=20

# Per-API-call timeout, in seconds, for each grading call.
GRADEAI_GRADING_TIMEOUT_SECONDS=60

# Total attempts per grading call (1 = no retry). Only transient failures
# (429/5xx/timeouts) are retried; auth and out-of-credit errors fail fast.
GRADEAI_GRADING_MAX_ATTEMPTS=2

# Total attempts when the provider rejects its own malformed JSON
# ("json_validate_failed"). Never lower than GRADEAI_GRADING_MAX_ATTEMPTS.
GRADEAI_GRADING_JSON_MAX_ATTEMPTS=3

# --- Local sentence-embedding scorer (no LLM, no network, $0.00) ------------
# Grading with all-MiniLM-L6-v2 (22M parameters) on this server's own CPU.
# It scores rubric coverage by sentence similarity; it cannot explain a grade,
# and says so. See app/services/sbert.py for the formula.
#
# GETTING THE WEIGHTS ONTO THE BOX (do this at deploy time, not at the venue):
#     cd backend && .venv/bin/python -c "\
#     from sentence_transformers import SentenceTransformer; \
#     SentenceTransformer('all-MiniLM-L6-v2').save('models/all-MiniLM-L6-v2')"
# That writes ~87MB to backend/models/all-MiniLM-L6-v2 (gitignored). Then set
# GRADEAI_SBERT_ALLOW_DOWNLOAD=false so a missing copy fails at deploy time
# instead of silently depending on the venue's network during the demo.

# false switches the local scorer off entirely (reports available=false).
GRADEAI_SBERT_ENABLED=true

# Load the weights during startup instead of on the first request. Leave true:
# otherwise the first grading of the day pays the load cost live.
GRADEAI_SBERT_PRELOAD=true

# Directory holding the saved model. Empty = backend/models/all-MiniLM-L6-v2.
GRADEAI_SBERT_MODEL_DIR=

# Allow falling back to a Hugging Face download when no directory is present.
# Convenient on a dev box; set false in production.
GRADEAI_SBERT_ALLOW_DOWNLOAD=true

# Cosine similarity at which a rubric point counts as covered by its
# best-matching sentence of the answer. 0.45 was chosen a priori from how this
# model family scores phrase-to-sentence pairs, not fitted to any answer.
# Raising it grades harder; lowering it grades more generously.
GRADEAI_SBERT_COVERAGE_THRESHOLD=0.45

# How much the secondary signal (whole answer vs the teacher's reference
# answers) moves the mark:
#     fraction = (1 - w) * rubric_coverage + w * reference_similarity
# 0.0 reports the similarity without letting it change the score.
GRADEAI_SBERT_REFERENCE_WEIGHT=0.15

# Server-side log verbosity (DEBUG/INFO/WARNING/ERROR). Retry attempts log at
# INFO and model failures at ERROR with a traceback and the provider's response
# body; the browser still only ever sees the short friendly error string.
GRADEAI_LOG_LEVEL=INFO

# Shared password required to write exams (POST /api/exams/ and
# PATCH /api/exams/{id}), sent by the admin UI as the X-Admin-Token header.
# Reads and the entire student flow stay open — no login anywhere.
# REQUIRED for admin edits: if this is unset, exam writes fail closed with 401
# and the server logs a warning at startup. Generate one with:
#     python3 -c "import secrets; print(secrets.token_urlsafe(24))"
GRADEAI_ADMIN_TOKEN=

# Set to true to log every SQL statement to stdout (noisy; development only).
GRADEAI_DB_ECHO=false
